ENVIRONMENT=development

# Base URLs of the microservices this gateway proxies to. Leave a URL empty
# to mark that service as "not deployed yet" -- the gateway then answers 503
# on its routes instead of trying (and failing) to connect.
AUTH_SERVICE_URL=http://localhost:8000
PARKING_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:8004
BOOKING_SERVICE_URL=

# Must be identical to auth-service's JWT_SECRET/JWT_ALGORITHM: the gateway
# verifies access tokens itself instead of calling auth-service on every
# proxied request.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EVENTS_EXCHANGE=parklink.events

CORS_ORIGINS=*
UPSTREAM_TIMEOUT_SECONDS=15
